@page
@model ErrorModel
@{
    ViewData["Title"] = "Não foi possível concluir a solicitação";
}

<section class="card error-card" aria-labelledby="error-title">
    <h1 id="error-title">@ViewData["Title"]</h1>
    <p class="lead">Você pode voltar à página inicial para tentar de novo ou consultar o catálogo de alimentos.</p>

    <div class="actions">
        <a class="btn" asp-page="/Index">Voltar ao início</a>
        <a class="btn btn-ghost" asp-page="/Foods">Consultar alimentos</a>
    </div>

    @if (Model.ShowRequestId)
    {
        <div class="error-reference">
            <h2>Código de referência</h2>
            <p class="muted">Se precisar relatar o problema à equipe do projeto, informe este código.</p>
            <code>@Model.RequestId</code>
        </div>
    }
</section>
